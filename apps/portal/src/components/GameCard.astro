---
import { gameUrl, type GameManifest } from "@dampf/game-kit";

interface Props {
  game: GameManifest;
}
const { game } = Astro.props;
const controls = [game.controls.keyboard && "Tastatur", game.controls.touch && "Touch"].filter(
  Boolean,
);
---

<li class="card">
  <a href={gameUrl(game.slug)} data-game={game.slug}>
    <img
      src={`${gameUrl(game.slug)}${game.thumbnail}`}
      alt={game.title}
      width="640"
      height="360"
      loading="lazy"
      decoding="async"
    />
    <div class="body">
      <div class="head">
        <h2>{game.title}</h2>
        <span class="version" aria-label={`Version ${game.version}`}>
          v{game.version}
        </span>
      </div>
      <p>{game.description}</p>
      <ul class="controls" aria-label="Steuerung">
        {controls.map((c) => (
          <li>
            {c === "Tastatur" ? "⌨" : "☝"} {c}
          </li>
        ))}
      </ul>
    </div>
  </a>
</li>

<style>
  .card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
    background: var(--panel);
    border: 3px solid #000;
    box-shadow: 6px 6px 0 #000;
    transition:
      transform 0.1s steps(2),
      box-shadow 0.1s steps(2);
  }
  .card a:hover,
  .card a:focus-visible {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 var(--accent);
    outline: none;
  }
  .card a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    image-rendering: pixelated;
    border-bottom: 3px solid #000;
    background: var(--bg);
  }
  .body {
    padding: 1rem 1.1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .version {
    font-size: 0.8rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  h2 {
    font-family: var(--pixel);
    font-size: 1rem;
    color: var(--accent);
    margin: 0;
  }
  p {
    margin: 0;
    line-height: 1.5;
    flex: 1;
  }
  .controls {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.85rem;
  }
  .controls li {
    padding: 0.15rem 0.5rem;
    border: 2px solid var(--muted);
    color: var(--muted);
  }
</style>
