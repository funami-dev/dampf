{
  "name": "dampf",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "packages/*",
    "games/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/portal",
    "build": "tsx scripts/validate.ts && npm run build:games && npm run build -w apps/portal && tsx scripts/assemble.ts",
    "build:games": "tsx scripts/build-games.ts",
    "preview": "tsx scripts/serve.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:prod": "DAMPF_URL=https://dampf.vercel.app playwright test",
    "lint": "eslint . && prettier --check . && npm run typecheck --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "acorn": "^8.19.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
